{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M02 Evidence Record",
  "type": "object",
  "required": ["sequence","record_type","payload","parent_hash","record_hash"],
  "properties": {
    "sequence":{"type":"integer","minimum":0},
    "record_type":{"type":"string","minLength":1},
    "payload":{"type":"object"},
    "parent_hash":{"type":["string","null"]},
    "record_hash":{"type":"string","minLength":64,"maxLength":64}
  }
}
